<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/nlog-internal.log">

	<targets>
		<target xsi:type="File"
				name="errorFileTarget"
				fileName="${basedir}/logs/errors-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId:${scopeproperty:item=CorrelationId}|${message}|${exception:format=tostring}" />
		<target xsi:type="File"
				name="fileTarget"
				fileName="${basedir}/logs/application-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId:${scopeproperty:item=CorrelationId}|${message}|${exception:format=tostring}" />

		<target xsi:type="Console"
				name="consoleTarget"
				layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId:${scopeproperty:item=CorrelationId}|${message}|${exception:format=tostring}" />
	</targets>

	<rules>
		<logger name="*" minlevel="Error" writeTo="errorFileTarget" />
		<logger name="*" minlevel="Info" writeTo="fileTarget,consoleTarget" />
	</rules>

</nlog>
