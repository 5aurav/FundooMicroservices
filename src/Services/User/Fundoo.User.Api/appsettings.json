{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "fundoo-user-api",
    "Audience": "fundoo-clients",
    "ExpiryMinutes": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "fundoo-user-service",
    "ConsumerGroupId": "fundoo-user-group",
    "RetryCount": 3,
    "RetryBackoffMs": 1000
  },
  "Services": {
    "Notification": {
      "BaseUrl": "https://localhost:7003/",
      "AttemptTimeoutSeconds": 10,
      "TotalTimeoutSeconds": 25,
      "MaxRetryAttempts": 2,
      "RetryBaseDelayMs": 500
    }
  }
}
